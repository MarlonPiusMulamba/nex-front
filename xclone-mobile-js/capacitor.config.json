{
  "appId": "org.bugema.noticeboard",
  "appName": "Bugema Notice Board",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#ffffff",
      "showSpinner": true,
      "spinnerColor": "#D4AF37",
      "androidScaleType": "CENTER",
      "splashFullScreen": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#D4AF37",
      "sound": "beep.wav"
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "always"
  },
  "electron": {
    "customScheme": "capacitor-electron",
    "nodeIntegration": true,
    "standalone": true,
    "browserWindow": {
      "webSecurity": false
    }
  }
}
